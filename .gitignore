minio-data/

# Dataset files and images (large — download/provide separately)
# DV_Data is tracked and pushed to the repo; everything else under
# backend/data/ (e.g. the generated library/ file store) stays ignored.
backend/data/*
!backend/data/DV_Data/
images/
*.zip
*.tar.gz

# Local Qdrant binary + its data directory (Qdrant runs via Docker now)
/qdrant
/storage/
/snapshots/

# ML model files
*.pt
*.pth
*.bin
*.ckpt
*.safetensors

# CLIP model cache
.cache/

# Alembic
backend/alembic/__pycache__/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# MyPy
.mypy_cache/

# Project docs not for version control
RESUME.md

# Technical architecture doc: keep only the Markdown source under version
# control. The LaTeX source and everything pdflatex generates from it
# (PDF output + build byproducts: .aux/.log/.out/.toc/etc.) are local,
# regeneratable artifacts, not something to commit.
TECHNICAL_ARCHITECTURE.*
!TECHNICAL_ARCHITECTURE.md
