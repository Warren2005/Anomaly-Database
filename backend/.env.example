# Copy this file to .env and adjust for your machine. .env itself is
# gitignored — every person running this backend sets their own.

# Where the backend stores all its data (metadata.json, feedback.json,
# embedding_cache.json, images/, logs/). Point this at a folder inside a
# cloud-synced drive (e.g. your local Dropbox client's copy of the shared
# team folder) so it inherits automatic version history / backup for free
# — see RUNNING_INSTRUCTIONS.md's "Backups" section. This path differs per
# machine (depends on your drive letter/username), which is exactly why
# it lives in .env and not in code.
LIBRARY_DATA_DIR=./data/library

# Port the FastAPI backend listens on. Change this if 8000 is already used
# by something else on your machine (common with corporate software).
API_PORT=8000

# CLIP model used for the primary search embedding — keep these matched
# across everyone's machine, since a mismatch means your embeddings live
# in a different vector space (see app/services/file_store.py).
CLIP_MODEL_NAME=ViT-L/14
CLIP_PRETRAINED=openai

# "cpu" works everywhere with no extra setup. Set to "cuda" only if this
# machine has an NVIDIA GPU AND you've installed the matching CUDA build
# of torch/torchvision (see the comment in requirements.txt).
CLIP_DEVICE=cpu

# Passkey required (via the X-Delete-Passkey header) to delete a library
# entry. This is a lightweight speed bump against accidental deletes, not
# a real auth system — this app deliberately has none, see
# RUNNING_INSTRUCTIONS.md. Keep this the same across everyone's machine so
# the same passkey works for everyone.
LIBRARY_DELETE_PASSKEY=admin123
